{
  "manifest_version": 3,
  "name": "One-Click Video Downloader",
  "version": "2.7.0",
  "description": "One click to save TikTok, Instagram and other videos with local engine. Batch-download a whole page, then see what your saved videos have in common.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "contextMenus",
    "notifications",
    "storage",
    "alarms",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Download this video",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "icons": {
    "128": "icon.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      }
    }
  },
  "optional_host_permissions": [
    "https://www.tiktok.com/*",
    "https://www.instagram.com/*",
    "https://www.youtube.com/*",
    "https://x.com/*",
    "https://twitter.com/*"
  ]
}