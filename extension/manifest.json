{
  "manifest_version": 3,
  "name": "Xark Once Click Video Agent",
  "version": "3.6.0",
  "description": "Save TikTok, Instagram and other videos in one click with local engine. Pick videos on a page, sort them into collections, and get AI recommendations from your own library.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "contextMenus",
    "notifications",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Xark Once Click Video Agent",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "icons": {
    "128": "icon.png"
  },
  "commands": {
    "_execute_action": {},
    "download-current": {
      "description": "Download the video on the current tab",
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      }
    }
  },
  "optional_host_permissions": [
    "https://www.tiktok.com/*",
    "https://www.instagram.com/*",
    "https://www.youtube.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://api.anthropic.com/*"
  ]
}