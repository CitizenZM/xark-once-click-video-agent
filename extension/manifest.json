{
  "manifest_version": 3,
  "name": "One-Click Video Downloader",
  "version": "1.0.1",
  "description": "Click once to download the video on this page (TikTok, Instagram, and more) using local engine.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "contextMenus",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Download this video",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "icons": {
    "128": "icon.png"
  }
}